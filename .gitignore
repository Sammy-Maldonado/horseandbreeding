# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
# Generated by @nuxt/test-utils when the Nuxt test environment boots.
.nuxtrc

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
.vscode/
.vite-cache/
components.d.ts

# Real source documents supplied by Marcus (client data, this repo is public).
# Only the README is tracked; nothing under private/ is ever committed.
data/private/

# Legacy PHP site + DB dump: read-only reference, never imported at runtime.
# Kept out of git history (~88MB of binaries); only the README is tracked.
_legacy/*
!_legacy/README.md

# Prisma 7 generated client (ADR-015): machine-generated, deterministically
# recreated by postinstall (`prisma generate`); never versioned.
/generated/prisma/

# Python bytecode caches written by the extractor and its tests.
__pycache__/
*.pyc
