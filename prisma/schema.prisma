  location   String? // Seller's location (optional)
  user       users?       @relation(fields: [user_id], references: [id]) // Foreign key linking to the Users table
  user_id    Int? // Foreign key field to link with User
  created_at DateTime     @default(now()) // Timestamp when the seller was added
  updated_at DateTime     @updatedAt // Timestamp when the seller's details were last updated
  storehorse storehorse[]

  @@map("sellers") // Optional: if the table name should be "Sellers" in the DB
}

model user_role_scope {
  id       Int        @id @default(autoincrement())
  role     user_roles @relation(fields: [role_id], references: [id])
  role_id  Int
  scope    scopes     @relation(fields: [scope_id], references: [id])
  scope_id Int

  // Additional fields can be added, e.g., `granted_by`, `granted_at`
  @@unique([role_id, scope_id]) // Add a composite unique constraint
}

model competition_history {
  competition_history_id Int      @id @default(autoincrement())
  horse_name            String?   @db.VarChar(255)
  storehorse_id         Int?      @db.Int
  rider                 String?   @db.VarChar(255)
  competition_year      Int?      @db.Int
  location              String?   @db.VarChar(255)
  csi                   String?   @db.VarChar(10)
  type                  String?   @db.VarChar(10)
  height                Decimal?  @db.Decimal(5, 2)
  placed_in_competition String?   @db.VarChar(50)
  detail                String?   @db.VarChar(255)
  status                Boolean   @default(true)
  created               DateTime  @default(now()) @db.Timestamp(0)
  // HOR-9 additive structured evolution (ADR-018). Every column below is
  // nullable: legacy rows keep working untouched, NULL means "not captured
  // by ingestion". `storehorse_id` stays the horse that ACHIEVED the result.
  discipline_code        String?                      @db.VarChar(20)
  result_kind            competition_result_kind?
  event_name             String?                      @db.VarChar(255)
  level_code             String?                      @db.VarChar(20)
  participation          competition_participation?
  country_code           String?                      @db.VarChar(3)
  raw_source_segment     String?                      @db.Text
  ingestion_run_id       Int?
  canonicalisation_state ingestion_persistence_state?
  storehorse            storehorse? @relation(fields: [storehorse_id], references: [horse_id])
  ingestionRun           ingestion_run?               @relation(fields: [ingestion_run_id], references: [ingestion_run_id], onDelete: Restrict)
  sourceAssertions       source_assertion[]
  @@index([storehorse_id])
  @@index([ingestion_run_id])
  @@map("competition_history")
}


// ---------------------------------------------------------------------------
// Canonical relational model around storehorse (HOR-9 — ADR-018, ADR-005,
// ADR-017).
//
// storehorse stays the single canonical horse registry. Every model below is
// anchored to storehorse.horse_id; none of them is a second horse table and
// none of them duplicates the pedigree chain (storehorse.sire_id / dam_id).
// Relations towards the MyISAM storehorse table are declared for typed
// navigation; their FOREIGN KEY statements are deferred in the migration
// (ADR-012 deferral list), exactly like competition_history.storehorse_id.
// Design reference: docs/data/canonical-relational-model.md
// ---------------------------------------------------------------------------

/// Zero-loss outcome of one extracted item after canonicalisation (ADR-018).
enum ingestion_persistence_state {
  CANONICALISED_STRUCTURED
  CANONICALISED_RELATIONSHIP
  PRESERVED_SOURCE_FACT
  AMBIGUOUS
  CONFLICT
  EXPLICITLY_UNSUPPORTED
  ERROR
}

/// Identity resolution outcome for the horse an assertion is about (ADR-018).
enum identity_resolution_outcome {
  NOT_ATTEMPTED
  EXISTING_HORSE
  NEW_HORSE
  AMBIGUOUS
  CONFLICT
}

enum source_document_type {
  WORD_CATALOGUE
  EXCEL_AUCTION_LIST
  OTHER
}

enum ingestion_run_status {
  STARTED
  COMPLETED
  FAILED
  ABORTED
}

/// What one source assertion claims. Closed vocabulary derived from the
/// write-up grammar (docs/domain/writeup-grammar.md).
enum source_assertion_kind {
  SUBJECT_IDENTITY
  BIRTH_YEAR
  PEDIGREE_DAM
  PEDIGREE_SIRE
  DESCENDANT_LINK
  MATERNAL_WRITEUP
  COMPETITION_RESULT
  APPROVAL
  STUDBOOK
  DISCIPLINE
  SPORT_LEVEL
  RIDER
  COUNTRY
  SIRE_NOTE
  HEAD_NOTE
  SEE_ABOVE_REFERENCE
  FREE_TEXT
  UNSUPPORTED_STRUCTURE
  EXTRACTION_ERROR
}

enum writeup_lifecycle_state {
  IMPORTED
  APPROVED
  CORRECTED
}

/// Mirrors the extractor placing vocabulary: placed / won / competed.
enum competition_result_kind {
  PLACED
  WON
  COMPETED
}

enum competition_participation {
  INDIVIDUAL
  TEAM
}

enum canonical_target_kind {
  STOREHORSE_FIELD
  STOREHORSE_DAM
  STOREHORSE_SIRE
  CANONICAL_WRITEUP
  COMPETITION_HISTORY
  APPROVAL_LINK
  STUDBOOK_LINK
  DISCIPLINE_LINK
}

enum canonical_change_kind {
  CREATED
  UPDATED
  CONFIRMED
  REVERTED
}

/// A registered ingestion source (a completed Word catalogue, an auction Excel).
/// Identity and metadata only — never the document binary.
model source_document {
  source_document_id  Int                  @id @default(autoincrement())
  /// Stable key shared with the extractor output (document_id).
  document_key        String               @unique @db.VarChar(64)
  /// SHA-256 of the document bytes, hex encoded.
  content_fingerprint String               @unique @db.Char(64)
  document_type       source_document_type
  catalogue_name      String?              @db.VarChar(191)
  catalogue_year      Int?
  /// Private location reference under data/private. Never exposed to clients or logs.
  source_reference    String?              @db.VarChar(255)
  byte_size           Int?
  notes               String?              @db.Text
  registered_at       DateTime             @default(now())
  ingestionRuns       ingestion_run[]
  canonicalWriteups   canonical_writeup[]
  sourceAssertions    source_assertion[]
}

/// One execution of the extractor + canonicalisation over one source document.
/// run_key is deterministic (fingerprint + versions) so re-runs are idempotent.
model ingestion_run {
  ingestion_run_id        Int                      @id @default(autoincrement())
  run_key                 String                   @unique @db.VarChar(128)
  source_document_id      Int
  extractor_version       String                   @db.VarChar(32)
  output_contract_version String                   @db.VarChar(32)
  run_status              ingestion_run_status     @default(STARTED)
  started_at              DateTime                 @default(now())
  completed_at            DateTime?
  total_source_nodes      Int?
  accounted_nodes         Int?
  unaccounted_nodes       Int?
  /// Counts per persistence state and per assertion kind.
  accounting_summary      Json?
  error_summary           String?                  @db.Text
  created_by              String?                  @db.VarChar(100)
  sourceDocument          source_document          @relation(fields: [source_document_id], references: [source_document_id], onDelete: Restrict)
  sourceAssertions        source_assertion[]
  canonicalWriteups       canonical_writeup[]
  competitionHistory      competition_history[]
  canonicalChangeAudits   canonical_change_audit[]

  @@index([source_document_id])
  @@index([run_status])
}

/// The canonical maternal write-up of one mare (ADR-005): at most one row per
/// storehorse.horse_id, reused by every foal in her line through dam_id.
/// Content only — never PDF-shaped. Conflicting variants stay as assertions.
model canonical_writeup {
  writeup_id         Int                     @id @default(autoincrement())
  horse_id           Int                     @unique
  content            String                  @db.Text
  /// SHA-256 of the normalised content, for identical-reuse and conflict detection.
  content_hash       String                  @db.Char(64)
  lifecycle_state    writeup_lifecycle_state @default(IMPORTED)
  version            Int                     @default(1)
  source_document_id Int?
  ingestion_run_id   Int?
  approved_by        String?                 @db.VarChar(100)
  approved_at        DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt
  horse              storehorse              @relation(fields: [horse_id], references: [horse_id])
  sourceDocument     source_document?        @relation(fields: [source_document_id], references: [source_document_id], onDelete: Restrict)
  ingestionRun       ingestion_run?          @relation(fields: [ingestion_run_id], references: [ingestion_run_id], onDelete: Restrict)
  sourceAssertions   source_assertion[]

  @@index([source_document_id])
  @@index([ingestion_run_id])
  @@index([lifecycle_state])
}

/// The zero-loss evidence ledger: one row per extracted claim, with its exact
/// source coordinates, raw text, interpretation and persistence outcome.
/// Many assertions may point at one canonical fact (cross-document reuse);
/// an unresolved assertion never creates a horse — horse_id simply stays NULL.
model source_assertion {
  source_assertion_id     Int                         @id @default(autoincrement())
  /// Deterministic key (document fingerprint + node + kind + position).
  assertion_key           String                      @unique @db.VarChar(128)
  source_document_id      Int
  ingestion_run_id        Int
  node_id                 String                      @db.VarChar(64)
  block_index             Int
  lot_order               Int?
  section_ordinal         Int?
  section_occurrence      Int?
  item_order              Int?
  chain_index             Int?
  segment_index           Int?
  text_offset             Int?
  nesting_depth           Int                         @default(0)
  assertion_kind          source_assertion_kind
  subject_name_raw        String?                     @db.VarChar(255)
  subject_name_normalised String?                     @db.VarChar(255)
  raw_text                String                      @db.Text
  interpreted_payload     Json?
  persistence_state       ingestion_persistence_state
  state_reason            String?                     @db.VarChar(255)
  resolution_outcome      identity_resolution_outcome @default(NOT_ATTEMPTED)
  /// The canonical horse this assertion is about, once resolved.
  horse_id                Int?
  /// The other canonical horse of a relationship assertion (dam, sire, descendant).
  related_horse_id        Int?
  writeup_id              Int?
  competition_history_id  Int?
  decided_by              String?                     @db.VarChar(100)
  decided_at              DateTime?
  decision_note           String?                     @db.VarChar(255)
  created_at              DateTime                    @default(now())
  updated_at              DateTime                    @updatedAt
  sourceDocument          source_document             @relation(fields: [source_document_id], references: [source_document_id], onDelete: Restrict)
  ingestionRun            ingestion_run               @relation(fields: [ingestion_run_id], references: [ingestion_run_id], onDelete: Restrict)
  horse                   storehorse?                 @relation("SourceAssertionHorse", fields: [horse_id], references: [horse_id])
  relatedHorse            storehorse?                 @relation("SourceAssertionRelatedHorse", fields: [related_horse_id], references: [horse_id])
  writeup                 canonical_writeup?          @relation(fields: [writeup_id], references: [writeup_id], onDelete: Restrict)
  competitionHistory      competition_history?        @relation(fields: [competition_history_id], references: [competition_history_id], onDelete: Restrict)
  canonicalChangeAudits   canonical_change_audit[]
  identityReviewCases     identity_review_case[]

  @@index([source_document_id, node_id])
  @@index([ingestion_run_id])
  @@index([horse_id])
  @@index([related_horse_id])
  @@index([writeup_id])
  @@index([competition_history_id])
  @@index([persistence_state])
  @@index([assertion_kind])
  @@index([subject_name_normalised])
}

/// Audit of every canonical change made from source evidence: previous value,
/// new value, decision and run, so one ingestion run can be reversed by its context.
model canonical_change_audit {
  canonical_change_audit_id Int                   @id @default(autoincrement())
  ingestion_run_id          Int?
  source_assertion_id       Int?
  horse_id                  Int?
  target_kind               canonical_target_kind
  target_id                 Int?
  field_name                String?               @db.VarChar(64)
  previous_value            String?               @db.Text
  new_value                 String?               @db.Text
  change_kind               canonical_change_kind
  decided_by                String?               @db.VarChar(100)
  decision_note             String?               @db.VarChar(255)
  created_at                DateTime              @default(now())
  ingestionRun              ingestion_run?        @relation(fields: [ingestion_run_id], references: [ingestion_run_id], onDelete: Restrict)
  sourceAssertion           source_assertion?     @relation(fields: [source_assertion_id], references: [source_assertion_id], onDelete: Restrict)
  horse                     storehorse?           @relation(fields: [horse_id], references: [horse_id])

  @@index([ingestion_run_id])
  @@index([source_assertion_id])
  @@index([horse_id])
  @@index([target_kind, target_id])
}

/// HOR-142 (ADR-018 §5, §11). Outcomes that are review material — the other
/// two resolver outcomes never create a case.
enum identity_review_outcome {
  AMBIGUOUS
  CONFLICT
}

enum identity_review_state {
  OPEN
  DECIDED
}

/// The human decision on a review case. Only ASSIGNED_EXISTING_HORSE carries a
/// horse reference; APPROVED_NEW_HORSE authorises the HOR-13 creation path
/// without inserting anything here.
enum identity_review_decision {
  ASSIGNED_EXISTING_HORSE
  APPROVED_NEW_HORSE
  KEPT_TEXT_ONLY
  REJECTED
}

/// Mirrors the HOR-14 resolver's candidate classification vocabulary.
enum identity_candidate_classification {
  SUPPORTED
  CONFLICTED_SUPPORTED
  MIXED
  NEUTRAL
  CONTRADICTED
  EXCLUDED
}

/// Durable review case for one AMBIGUOUS / CONFLICT resolution (HOR-142).
/// Anchored to the `source_assertion` evidence ledger — the raw Word text
/// stays there; this row snapshots the decision-time resolution evidence.
model identity_review_case {
  identity_review_case_id   Int                        @id @default(autoincrement())
  /// Deterministic idempotency key: sha256(assertion key + outcome + resolver contract version).
  review_case_key           String                     @unique @db.Char(64)
  source_assertion_id       Int
  outcome                   identity_review_outcome
  name_key                  String?                    @db.VarChar(255)
  reason_codes              Json
  source_conflicts          Json
  establishment             Json
  resolver_contract_version String                     @db.VarChar(31)
  review_state              identity_review_state      @default(OPEN)
  decision                  identity_review_decision?
  /// Set only by an ASSIGNED_EXISTING_HORSE decision — a reference to the
  /// current canonical horse, never a snapshot.
  decided_horse_id          Int?
  decided_by                String?                    @db.VarChar(100)
  decided_at                DateTime?
  decision_note             String?                    @db.VarChar(255)
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  sourceAssertion           source_assertion           @relation(fields: [source_assertion_id], references: [source_assertion_id], onDelete: Restrict)
  decidedHorse              storehorse?                @relation("IdentityReviewDecidedHorse", fields: [decided_horse_id], references: [horse_id])
  candidates                identity_review_candidate[]

  @@index([source_assertion_id])
  @@index([review_state])
  @@index([outcome])
  @@index([decided_horse_id])
}

/// Immutable decision-time snapshot of one evaluated candidate: which
/// `storehorse.horse_id` was considered and exactly why it did not resolve.
model identity_review_candidate {
  identity_review_candidate_id Int                               @id @default(autoincrement())
  identity_review_case_id      Int
  horse_id                     Int
  candidate_order              Int
  candidate_name               String                            @db.VarChar(255)
  classification               identity_candidate_classification
  signals                      Json
  corroborations               Json
  contradictions               Json
  rejection_reasons            Json
  reviewCase                   identity_review_case              @relation(fields: [identity_review_case_id], references: [identity_review_case_id], onDelete: Restrict)
  horse                        storehorse                        @relation("IdentityReviewCandidateHorse", fields: [horse_id], references: [horse_id])

  @@unique([identity_review_case_id, candidate_order], map: "identity_review_candidate_case_order_key")
  @@index([horse_id])
}
