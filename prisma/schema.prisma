// The historical `access_tokens` table is gone: access tokens are short-lived
// JWTs verified statelessly and never persisted. The removal evidence and the
// modern design live in docs/adr/ADR-013-modern-authentication-architecture.md.

// One row per active refresh session. The credential is opaque and
// cryptographically random; only its SHA-256 digest is persisted. Rotation
// replaces the row inside one transaction; a digest miss is a replay and is
// rejected. The historical table name `refresh_tokens` is kept deliberately —
// see ADR-013. The session belongs to the user alone: the legacy OAuth
// `client_id` column was removed with the rest of the unused OAuth token
// bookkeeping.
model refresh_tokens {
  id         Int      @id @default(autoincrement())
  token_hash Bytes    @unique @db.Binary(32)
  user_id    Int
  created_at DateTime @default(now())
  expires_at DateTime
  user       users    @relation(fields: [user_id], references: [id])
}

model scopes {
  id              Int               @id @default(autoincrement())
  scope_name      String            @unique
  description     String
  user_role_scope user_role_scope[]
}

model user_roles {
  id              Int               @id @default(autoincrement())
  user_id         Int
  role_name       String
  user            users             @relation(fields: [user_id], references: [id])
  user_role_scope user_role_scope[]

  // A role name is shared across users; it is unique only per user. A global
  // unique on `role_name` would let exactly one user ever hold the "User"
  // role and block every subsequent registration.
  @@unique([role_name, user_id])
}

model horse_views {
  id             Int      @id @default(autoincrement())
  horse_id       Int
  views          Int      @default(0)
  last_viewed_at DateTime @default(now())

  horse storehorse @relation(fields: [horse_id], references: [horse_id]) // Assuming `id` is the primary key in `StoreHorse` model
}

model sellers {
  id         Int          @id @default(autoincrement()) // Unique identifier for each seller (Primary Key)
  full_name  String       @default("") @db.VarChar(255)
  mobile     String       @default("") @db.VarChar(20)
